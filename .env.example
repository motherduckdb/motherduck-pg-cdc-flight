# Copy to .env (git-ignored). Never commit it, print it or paste its values into a chat.

# MotherDuck token: the org that owns the Flights (setup.md step 1 checks it).
# Also used by the MotherDuck tests when CDC_TEST_MD=1.
motherduck_token=

# The source (setup.md step 0), for the local CLI and checks:
#   uv run --env-file .env cdc-flight ...
# In Flights, the DSN lives in a MotherDuck secret; only non-secret values go in config.
CDC_SOURCE_ID=
# The keyed tables, as a JSON list: '["public.orders", "public.customers"]'
CDC_TABLES=
# The CDC role's DSN, one line, single-quoted (unquoted, uv's --env-file drops it and
# every line after it):
# CDC_PG_DSN='host=<endpoint host name> port=5432 dbname=<database> user=<role> password=<password> sslmode=require'
CDC_PG_DSN=

# Only if the source uses names other than the defaults:
# CDC_SLOT=md_cdc_<source>
# CDC_PUBLICATION=md_cdc_<source>_pub
# CDC_HEARTBEAT=public.md_cdc_heartbeat
# CDC_DATABASE=cdc_internal
# CDC_RUNTIME_SECONDS=540
